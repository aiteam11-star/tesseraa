# Copy to .env (or .env.local) and fill in what you need. Never commit real values.

# --- Required ---
# PostgreSQL connection string. Local default matches docker-compose.yml. See README "Deploying" for hosted options.
DATABASE_URL="postgresql://tessera:tessera@127.0.0.1:5432/tessera"

# --- Optional ---
# Public address of the site. Used to build password-reset links. Example: https://tessera.example.com
APP_URL=""

# Where uploaded files (avatars, resumes, portfolio) are stored. Defaults to ./storage. Keep it outside /public.
STORAGE_DIR=""

# Optional. Store uploads in S3-compatible object storage instead of the local folder (needed on serverless hosts).
# Works with AWS S3, Cloudflare R2, Supabase Storage and MinIO. Keep the bucket PRIVATE.
S3_BUCKET=""
S3_REGION=""                # defaults to us-east-1
S3_ENDPOINT=""              # only for non-AWS services, e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX=""                # optional folder inside the bucket, to keep environments apart
S3_FORCE_PATH_STYLE=""      # defaults to true when S3_ENDPOINT is set

# AI features. Without a key every feature falls back to rule-based logic and the app still works.
ANTHROPIC_API_KEY=""

# Email for password-reset links (https://resend.com). Without these, reset links are only shown on screen
# in development and are NOT sent in production.
RESEND_API_KEY=""
EMAIL_FROM=""

# Email verification is enforced automatically when the two settings above are set.
# Set to "true" to force it on (development prints the link in the server log) or "false" to force it off.
REQUIRE_EMAIL_VERIFICATION=""

# Optional. Shared Redis for live updates and rate limits across several server instances.
# Without it the app uses in-process memory, which is correct for a single instance.
REDIS_URL=""
